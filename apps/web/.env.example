VITE_API_BASE_URL=http://localhost:18000

# Basemap tiles (any XYZ raster template). Defaults to the public OpenStreetMap
# server; point this at a local or departmental tile server when the console
# runs on a network without internet. Camera pins and routes do not depend on it.
# VITE_MAP_TILE_URL=http://10.0.0.5:8080/tiles/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
