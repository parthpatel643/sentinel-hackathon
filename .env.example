# Sentinel Platform — local environment overrides.
#
# Copy to `.env` and fill in real values. `.env` is gitignored; never commit
# real credentials. All variables use the SENTINEL_ prefix (see
# packages/sentinel_core/src/sentinel_core/config.py).

# --- Government test grid ("Sentinel Camera Grid") --------------------------
# Registered email + access password for the grid at cctv.corp8.cloud /
# 103.250.160.189. RTSP and WHEP authenticate every connection with these
# credentials embedded in the URL; HLS sits behind a separate portal password.
# Only emails on the approved access list can connect.
SENTINEL_GOV_ACCESS_EMAIL=
SENTINEL_GOV_ACCESS_PASSWORD=

# Override only if the organisers change the endpoint — discovery is always
# catalogue-driven, so camera ids themselves never belong here.
# SENTINEL_GOV_CATALOGUE_URL=https://cctv.corp8.cloud/cameras.json
# SENTINEL_GOV_HLS_BASE_URL=https://cctv.corp8.cloud
# SENTINEL_GOV_RTSP_HOST=103.250.160.189

# --- Local infrastructure (only needed if you changed the compose defaults) -
# SENTINEL_DB_HOST=localhost
# SENTINEL_DB_PORT=15432
# SENTINEL_DB_USER=sentinel
# SENTINEL_DB_PASSWORD=sentinel
# SENTINEL_DB_NAME=sentinel

# --- Serving the console from somewhere other than localhost ---------------
# The API rejects cross-origin requests from anywhere not listed here, and the
# default covers the Vite dev server only. Getting this wrong looks like the
# console loading correctly and then every request failing, which reads like
# an auth problem and is not.
# SENTINEL_CORS_ALLOW_ORIGINS=["https://your-console.example","http://localhost:5173"]

# The HLS URL handed to the browser for live preview. Only needed when the
# browser reaches the media relay on a different host than the API does — a
# tunnel, a reverse proxy, or a separate media host. Left unset it points at
# the local relay, which is correct for a single-machine run.
# SENTINEL_RELAY_HLS_URL=https://your-relay.example
