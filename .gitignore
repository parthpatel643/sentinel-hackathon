# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv

# Secrets and local overrides
.env
.env.local

# mTLS certs/keys are generated locally by scripts/generate_mtls_certs.sh,
# never committed — see infra/tls/README.md
infra/tls/*.crt
infra/tls/*.key
infra/tls/*.srl
infra/tls/*.csr

# Model weights are downloaded, never committed (see models/README.md)
models/weights/
*.pt
*.onnx
*.mlpackage

# Local evidence output (benchmark CSVs are committed deliberately)
evidence/runs/

# SBOMs are regenerated per release with `make sbom` — always fresh, never
# committed (a stale SBOM claiming to describe a build it doesn't is worse
# than no SBOM at all).
sbom/

# The submission PDF is generated from docs/ with `npm run docs:pdf`, for the
# same reason as the SBOMs above: a committed PDF silently disagreeing with
# the markdown it was built from is worse than no PDF. Regenerate it as the
# last step before submitting.
docs/Sentinel-Platform-HLD.pdf
docs/Sentinel-Platform-Deck.pptx
docs/deck-qa.pdf

# Node
node_modules/
apps/*/dist/
apps/web/test-results/
apps/web/playwright-report/

# Locally installed AI coding-agent skills — not part of the product
.agents/
.claude/
skills-lock.json

# OS
.DS_Store
var/

# Runtime data written by a live dev stack: MediaMTX recordings
# (recordings_dir), edge-side snapshot writes (SnapshotWriter's
# data/snapshot_originals) — regenerated by running the stack, never
# committed.
data/
