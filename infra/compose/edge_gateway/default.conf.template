# mTLS edge gateway — terminates mutual TLS for edge-node -> core-api
# traffic and forwards the verified client certificate's CN as a header,
# alongside a shared secret core_api uses to trust it (see
# core_api/security/mtls.py and sentinel_core.config's
# `mtls_gateway_shared_secret`).
#
# Mounted at /etc/nginx/templates/default.conf.template — the official
# nginx image's entrypoint envsubst's this at container start (substituting
# only real environment variables, so nginx's own runtime `$variables`
# below are left untouched) and writes the result to
# /etc/nginx/conf.d/default.conf.
upstream core_api_upstream {
  server ${CORE_API_UPSTREAM};
}

server {
  listen 8443 ssl;
  server_name edge-gateway.sentinel.local;

  ssl_certificate     /etc/nginx/tls/server.crt;
  ssl_certificate_key /etc/nginx/tls/server.key;

  # The whole point: refuse any connection that doesn't present a client
  # certificate signed by our CA. This is enforced at the TLS handshake —
  # a client without a valid cert never even reaches a request handler.
  ssl_client_certificate /etc/nginx/tls/ca.crt;
  ssl_verify_client on;
  ssl_verify_depth 2;

  location / {
    proxy_pass http://core_api_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Client-DN $ssl_client_s_dn;
    proxy_set_header X-Edge-Gateway-Secret "${MTLS_GATEWAY_SHARED_SECRET}";
    proxy_set_header X-Forwarded-For $remote_addr;
  }
}
